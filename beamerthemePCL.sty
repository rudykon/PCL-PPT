}
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.55cm,dp=0pt]{normal text}
    \begin{tikzpicture}[remember picture,overlay]
      \draw[PCLLine,line width=0.4pt]
        ([xshift=0.8cm,yshift=0.51cm]current page.south west)
        -- ([xshift=-0.8cm,yshift=0.51cm]current page.south east);
      \pgfmathsetmacro{\pcl@progress}{14.4*min(1,max(0,\insertframenumber/max(1,\inserttotalframenumber)))}
      \draw[PCLBlue,line width=0.9pt]
        ([xshift=0.8cm,yshift=0.51cm]current page.south west)
        -- ([xshift={(0.8+\pcl@progress)*1cm},yshift=0.51cm]current page.south west);
      \node[anchor=west,inner sep=0pt,font=\tiny,text=PCLMuted]
        at ([xshift=0.8cm,yshift=0.22cm]current page.south west) {\insertshorttitle};
      \begin{scope}[shift={([xshift=-2.65cm,yshift=0.14cm]current page.south east)}]
        \pcl@bars
      \end{scope}
      \node[anchor=east,inner sep=0pt,font=\scriptsize\bfseries,text=PCLNavy]
        at ([xshift=-0.8cm,yshift=0.22cm]current page.south east)
        {\insertframenumber\,/\,\inserttotalframenumber};
    \end{tikzpicture}
  \end{beamercolorbox}%
}

