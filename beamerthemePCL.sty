      \begin{scope}[shift={([xshift=0.48cm,yshift=-0.80cm]current page.north west)}]
        \pcl@bars
      \end{scope}
      \node[anchor=west,inner sep=0pt,text width=12.3cm,align=left,text=PCLBlue]
        at ([xshift=1.78cm,yshift=-0.65cm]current page.north west) {%
          \usebeamerfont{frametitle}\strut\insertframetitle
          \ifx\insertframesubtitle\@empty\else
            \\[-0.3ex]{\usebeamerfont{framesubtitle}\color{PCLMuted}\insertframesubtitle}%
          \fi};
      \node[inner sep=0pt] at ([xshift=-0.97cm,yshift=-0.62cm]current page.north east)
        {\pcl@seal{0.96cm}};
      \pcl@drawtimeline{1.18cm}
