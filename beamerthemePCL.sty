% Read every section from Beamer's navigation data, including future sections.
% Labels and destinations follow \section[short title]{full title} automatically.
\newcount\pcl@timelinecount
\newcount\pcl@timelineactive
\newdimen\pcl@timelinelabelwidth
\newcommand{\pcl@collecttimeline}{%
  \pcl@timelinecount=0
  \pcl@timelineactive=0
  \def\slideentry##1##2##3##4##5##6{}%
  \def\beamer@subsectionentry##1##2##3##4##5{}%
  \def\beamer@subsubsectionentry##1##2##3##4##5##6{}%
  \def\sectionentry##1##2##3##4##5{%
    \ifnum##5=\c@part
      \advance\pcl@timelinecount by 1\relax
      \expandafter\def\csname pcl@timelinelabel@\the\pcl@timelinecount\endcsname{##2}%
      \expandafter\def\csname pcl@timelinefull@\the\pcl@timelinecount\endcsname{##4}%
      \expandafter\def\csname pcl@timelinepage@\the\pcl@timelinecount\endcsname{##3}%
      \ifnum##1=\c@section
        \pcl@timelineactive=\pcl@timelinecount
      \fi
    \fi
  }%
  \dohead
}
% Called inside a page-anchored TikZ picture; #1 is the top offset.
\newcommand{\pcl@drawtimeline}[1]{%
  \begingroup
  \pcl@collecttimeline
  \hypersetup{hidelinks}% keep the three navigation states' text colors
  \begin{scope}[shift={([yshift=-#1]current page.north west)},x=1cm,y=1cm]
    \fill[PCLLight] (0,0) rectangle (\paperwidth,-0.80);
    \ifnum\pcl@timelinecount>0
      \pgfmathsetmacro{\pcl@timelinestep}{14.4/\the\pcl@timelinecount}
      \pgfmathsetmacro{\pcl@timelinefirst}{0.8+0.5*\pcl@timelinestep}
      \pgfmathsetmacro{\pcl@timelinelast}{15.2-0.5*\pcl@timelinestep}
      \draw[PCLLine,line width=1pt]
        (\pcl@timelinefirst,-0.20) -- (\pcl@timelinelast,-0.20);
      \ifnum\pcl@timelineactive>0
        \pgfmathsetmacro{\pcl@timelineend}{0.8+(\the\pcl@timelineactive-0.5)*\pcl@timelinestep}
        \draw[PCLBlue,line width=1.2pt]
          (\pcl@timelinefirst,-0.20) -- (\pcl@timelineend,-0.20);
      \fi
      \pcl@timelinelabelwidth=14.4cm
      \divide\pcl@timelinelabelwidth by\pcl@timelinecount
      \advance\pcl@timelinelabelwidth by -2mm
      \foreach \i in {1,...,\the\pcl@timelinecount}{%
        \pgfmathsetmacro{\pcl@timelinex}{0.8+(\i-0.5)*\pcl@timelinestep}
        \def\pcl@timelinefg{PCLMuted}%
        \def\pcl@timelinebg{PCLLight}%
        \def\pcl@timelineweight{\mdseries}%
        \ifnum\i>\pcl@timelineactive
          \draw[draw=PCLMuted!60,fill=PCLLight,line width=0.6pt]
            (\pcl@timelinex,-0.20) circle[radius=0.065cm];
        \else
          \def\pcl@timelinefg{PCLBlue}%
          \fill[PCLBlue] (\pcl@timelinex,-0.20) circle[radius=0.065cm];
          \ifnum\i=\pcl@timelineactive
            \def\pcl@timelinefg{white}%
            \def\pcl@timelinebg{PCLBlue}%
            \def\pcl@timelineweight{\bfseries}%
            \draw[PCLCyan,line width=0.8pt]
              (\pcl@timelinex,-0.20) circle[radius=0.105cm];
          \fi
        \fi
        \node[inner sep=0pt] at (\pcl@timelinex,-0.20) {%
          \hyperlink{Navigation\csname pcl@timelinepage@\i\endcsname}{%
            \phantom{\rule{3mm}{3mm}}}};
        \node[align=center,rounded corners=1.4pt,inner xsep=0.8mm,inner ysep=0.65mm,
          text width=\pcl@timelinelabelwidth,text=\pcl@timelinefg,fill=\pcl@timelinebg,
          font=\fontsize{7.3}{8.5}\selectfont\pcl@timelineweight]
          at (\pcl@timelinex,-0.53) {%
            \hyperlink{Navigation\csname pcl@timelinepage@\i\endcsname}{%
              \ifnum\i<10 0\fi\i\enspace\csname pcl@timelinelabel@\i\endcsname}};
      }
    \fi
  \end{scope}%
  \endgroup
}


