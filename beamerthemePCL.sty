% Custom contents page using the supplied building photo and editable polygons.
\newcommand{\PCLcontents}{%
  \begin{frame}[plain]
    \begingroup
    \pcl@collecttimeline
    \begin{tikzpicture}[remember picture,overlay]
      \fill[white] (current page.north west) rectangle (current page.south east);
      \begin{scope}[shift={(current page.north west)}]
        \begin{scope}
          \clip (-2.7,-4.8) -- (0.65,-1.6) -- (4.0,-4.8) -- (0.65,-8.0) -- cycle;
          \node[inner sep=0pt] at (0.35,-4.8)
            {\includegraphics[height=6.5cm]{assets/campus.jpg}};
        \end{scope}
        \fill[PCLBlue!65!PCLCyan] (1.55,0) -- (6.00,0) -- (3.77,-1.60) -- cycle;
        \fill[PCLBlue] (2.20,0) -- (6.45,0) -- (4.32,-1.30) -- cycle;
        \node[white,font=\large\bfseries,inner sep=0pt] at (4.02,-0.46) {CONTENTS};
        \fill[PCLLight] (12.0,-9) -- (14.3,-5.85) -- (16,-9) -- cycle;
        \fill[PCLBlue] (12.7,-9) -- (14.65,-6.00) -- (16.6,-9) -- cycle;
        \node[inner sep=0pt] at (15.02,-0.77) {\pcl@seal{0.96cm}};
        \ifnum\pcl@timelinecount>0
          \foreach \i in {1,...,\the\pcl@timelinecount}{%
            \pgfmathsetmacro{\pcl@tocY}{-2.60-1.08*(\i-1)}
            \node[anchor=west,inner sep=0pt,text width=9.6cm,align=left,text=PCLBlue,
              font=\usebeamerfont{section in toc}]
              at (4.65,\pcl@tocY) {\hyperlink{Navigation\csname pcl@timelinepage@\i\endcsname}{%
                \PCLchn{\i}、\csname pcl@timelinefull@\i\endcsname}};
          }
        \fi
        \node[anchor=east,inner sep=0pt,text=PCLNavy,font=\scriptsize\bfseries]
          at (15.35,-8.58) {\insertframenumber\,/\,\inserttotalframenumber};
      \end{scope}
    \end{tikzpicture}
    \endgroup
  \end{frame}%
}
\setbeamertemplate{section page}{%
